func TestNextFrontierCrowding(t *testing.T) {
	ctx, cancel := structuredTestContext(t)
	defer cancel()
	var result json.RawMessage
	expr := `(()=>{document.body.innerHTML='<main>'+Array.from({length:150},(_,i)=>'<button style="position:fixed;top:0;left:0">Nav '+i+'</button>').join('')+'<input id="focus" aria-label="Focused" style="position:fixed;top:30px"><input aria-invalid="true" aria-label="Invalid" style="position:fixed;top:60px"><button id="changed" style="position:fixed;top:90px">Changed</button><button id="plain" style="position:fixed;top:120px">Relevant plain</button></main>';const walk=` + SnapshotFunctionScript + `;document.getElementById('focus').focus();const before=walk({mode:'frontier',limit:10,__brw_version:1,__brw_epoch:'crowd'});changed.textContent='Updated';const after=walk({mode:'frontier',limit:10,__brw_version:2,__brw_epoch:'crowd',since:1});const full=walk({mode:'frontier',limit:0});return {before:before.elements.map(e=>({name:e.name,signals:e.signals})),after:after.elements.map(e=>({name:e.name,signals:e.signals})),delta:after.delta,full_count:full.elements.length,changed_in_full:full.elements.some(e=>e.name==='Updated'),plain_in_full:full.elements.some(e=>e.name==='Relevant plain')}})()`
	if err := chromedp.Run(ctx, chromedp.Navigate("about:blank"), chromedp.Evaluate(expr, &result)); err != nil {
		t.Fatal(err)
	}
	t.Log(string(result))
}
